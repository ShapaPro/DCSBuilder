// Добавляет выбранное поле в настройки или группировку
//
// Параметры:
//   Элемент    - НастройкиКомпоновкиДанных, ГруппировкаКомпоновкиДанных - элемент настроек
//   ИмяПоля    - Строка - имя поля
//   Заголовок  - Строка - заголовок поля (необязательно)
//
// Возвращаемое значение:
//   ВыбранноеПолеКомпоновкиДанных - добавленное поле
//
Функция СздВыбранноеПоле(Элемент, ИмяПоля, Заголовок = Неопределено) Экспорт

    ВыбранноеПоле = Элемент.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
    ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
    ВыбранноеПоле.Использование = Истина;

    Если Заголовок <> Неопределено Тогда
        ВыбранноеПоле.Заголовок = Заголовок;
    КонецЕсли;

    Возврат ВыбранноеПоле;

КонецФункции

// Добавляет группу выбранных полей
//
// Параметры:
//   Элемент    - НастройкиКомпоновкиДанных, ГруппировкаКомпоновкиДанных - элемент настроек
//   Заголовок  - Строка - заголовок группы
//   Расположение - РасположениеПоляКомпоновкиДанных - расположение полей в группе
//
// Возвращаемое значение:
//   ГруппаВыбранныхПолейКомпоновкиДанных - добавленная группа
//
Функция СздГруппуВыбранныхПолей(Элемент, Заголовок = "", Расположение = Неопределено) Экспорт

    Группа = Элемент.Выбор.Элементы.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
    Группа.Заголовок = Заголовок;

    Если Расположение <> Неопределено Тогда
        Группа.Расположение = Расположение;
    КонецЕсли;

    Возврат Группа;

КонецФункции

// Добавляет автополе в выбранные поля
//
// Параметры:
//   Элемент - НастройкиКомпоновкиДанных, ГруппировкаКомпоновкиДанных - элемент настроек
//
// Возвращаемое значение:
//   АвтоВыбранноеПолеКомпоновкиДанных - добавленное автополе
//
Функция СздАвтоВыбранноеПоле(Элемент) Экспорт

    АвтоПоле = Элемент.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));

    Возврат АвтоПоле;

КонецФункции

// Добавляет несколько выбранных полей
//
// Параметры:
//   Элемент       - НастройкиКомпоновкиДанных, ГруппировкаКомпоновкиДанных - элемент настроек
//   МассивПолей   - Массив - массив имен полей (строк)
//
Процедура СздВыбранныеПоля(Элемент, МассивПолей) Экспорт

    Для Каждого ИмяПоля Из МассивПолей Цикл
        СздВыбранноеПоле(Элемент, ИмяПоля);
    КонецЦикла;

КонецПроцедуры

