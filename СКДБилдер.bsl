// Добавляет элемент сортировки
//
// Параметры:
//   Элемент         - НастройкиКомпоновкиДанных, ГруппировкаКомпоновкиДанных - элемент настроек
//   ИмяПоля         - Строка - имя поля
//   Направление     - НаправлениеСортировкиКомпоновкиДанных - направление сортировки
//
// Возвращаемое значение:
//   ЭлементПорядкаКомпоновкиДанных - добавленный элемент
//
Функция СздСортировку(Элемент, ИмяПоля, Направление = Неопределено) Экспорт

    ЭлементСортировки = Элемент.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
    ЭлементСортировки.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
    ЭлементСортировки.Использование = Истина;

    Если Направление = Неопределено Тогда
        ЭлементСортировки.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр;
    Иначе
        ЭлементСортировки.ТипУпорядочивания = Направление;
    КонецЕсли;

    Возврат ЭлементСортировки;

КонецФункции

// Добавляет сортировку по возрастанию
//
Функция СздСортировкуВозр(Элемент, ИмяПоля) Экспорт
    Возврат СздСортировку(Элемент, ИмяПоля, НаправлениеСортировкиКомпоновкиДанных.Возр);
КонецФункции

// Добавляет сортировку по убыванию
//
Функция СздСортировкуУбыв(Элемент, ИмяПоля) Экспорт
    Возврат СздСортировку(Элемент, ИмяПоля, НаправлениеСортировкиКомпоновкиДанных.Убыв);
КонецФункции

