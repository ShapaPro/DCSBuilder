#Область СлужебныеПроцедурыИФункции

// Устанавливает роль поля
//
Процедура УстановитьРольПоля(Поле, Роль)

    Если Не ЗначениеЗаполнено(Роль) Тогда
        Возврат;
    КонецЕсли;

    Роль = НРег(Роль);

    Если Роль = "измерение" Тогда
        Поле.Роль.Измерение = Истина;
    ИначеЕсли Роль = "реквизит" Тогда
        Поле.Роль.ИзмерениеРеквизит = Истина;
    ИначеЕсли Роль = "период" Тогда
        Поле.Роль.ПериодНомер = 1;
        Поле.Роль.ПериодДополнительный = Ложь;
    ИначеЕсли Роль = "счет" Тогда
        Поле.Роль.Счет = Истина;
    ИначеЕсли Роль = "баланс" Тогда
        Поле.Роль.Баланс = Истина;
    ИначеЕсли Роль = "игнорироватьзначенияnull" Тогда
        Поле.Роль.ИгнорироватьЗначенияNULL = Истина;
    ИначеЕсли Роль = "обязательное" Тогда
        Поле.Роль.Обязательное = Истина;
    КонецЕсли;

КонецПроцедуры

#КонецОбласти
