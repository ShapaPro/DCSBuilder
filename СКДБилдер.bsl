// Добавляет связь наборов данных
//
// Параметры:
//   СКД                    - СхемаКомпоновкиДанных - схема компоновки
//   ИсточникСвязи          - Строка - имя набора-источника
//   ПриемникСвязи          - Строка - имя набора-приемника
//   ВыражениеИсточника     - Строка - выражение источника связи
//   ВыражениеПриемника     - Строка - выражение приемника связи
//   Параметр               - Строка - имя параметра (необязательно)
//
// Возвращаемое значение:
//   СвязьНаборовДанныхСхемыКомпоновкиДанных - добавленная связь
//
Функция СздСвязьНаборов(СКД, ИсточникСвязи, ПриемникСвязи, ВыражениеИсточника, ВыражениеПриемника, Параметр = "") Экспорт

    Связь = СКД.СвязиНаборовДанных.Добавить();
    Связь.ИсточникСвязи = ИсточникСвязи;
    Связь.ПриемникСвязи = ПриемникСвязи;
    Связь.ВыражениеИсточника = ВыражениеИсточника;
    Связь.ВыражениеПриемника = ВыражениеПриемника;

    Если ЗначениеЗаполнено(Параметр) Тогда
        Связь.Параметр = Параметр;
    КонецЕсли;

    Возврат Связь;

КонецФункции

