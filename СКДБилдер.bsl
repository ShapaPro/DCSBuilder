#Область ПрограммныйИнтерфейс

#Область СозданиеСхемы

// Создает новую пустую схему компоновки данных
//
// Возвращаемое значение:
//   СхемаКомпоновкиДанных - новая схема
//
Функция СоздатьСхему() Экспорт

    Возврат Новый СхемаКомпоновкиДанных;

КонецФункции

// Создает схему компоновки данных с источником данных
//
// Параметры:
//   ИмяИсточника - Строка - имя источника данных, по умолчанию "ИсточникДанных1"
//
// Возвращаемое значение:
//   СхемаКомпоновкиДанных - схема с добавленным источником
//
Функция СоздатьСхемуСИсточником(ИмяИсточника = "ИсточникДанных1") Экспорт

    СКД = СоздатьСхему();
    СздИсточникДанных(СКД, ИмяИсточника);

    Возврат СКД;

КонецФункции

#КонецОбласти

#Область ИсточникиДанных

// Добавляет источник данных в схему
//
// Параметры:
//   СКД            - СхемаКомпоновкиДанных - схема компоновки
//   Имя            - Строка - имя источника, по умолчанию "ИсточникДанных1"
//   ТипИсточника   - Строка - тип источника: "Локальный" (по умолчанию)
//
// Возвращаемое значение:
//   ИсточникДанныхСхемыКомпоновкиДанных - добавленный источник
//
Функция СздИсточникДанных(СКД, Имя = "ИсточникДанных1", ТипИсточника = "Local") Экспорт

    ИсточникДанных = СКД.ИсточникиДанных.Добавить();
    ИсточникДанных.Имя = Имя;
    ИсточникДанных.ТипИсточникаДанных = ТипИсточника;

    Возврат ИсточникДанных;

КонецФункции

#КонецОбласти

#Область НаборыДанных

// Добавляет набор данных - запрос
//
// Параметры:
//   СКД              - СхемаКомпоновкиДанных - схема компоновки
//   Имя              - Строка - имя набора данных
//   ТекстЗапроса     - Строка - текст запроса
//   ИмяИсточника     - Строка - имя источника данных, по умолчанию "ИсточникДанных1"
//   АвтоЗаполнение   - Булево - автоматически заполнять поля, по умолчанию Истина
//
// Возвращаемое значение:
//   НаборДанныхЗапросСхемыКомпоновкиДанных - созданный набор данных
//
Функция СздНаборЗапрос(СКД, Имя, ТекстЗапроса, ИмяИсточника = "ИсточникДанных1", АвтоЗаполнение = Истина) Экспорт

    НаборДанных = СКД.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
    НаборДанных.Имя = Имя;
    НаборДанных.Запрос = ТекстЗапроса;
    НаборДанных.ИсточникДанных = ИмяИсточника;
    НаборДанных.АвтоЗаполнениеДоступныхПолей = АвтоЗаполнение;

    Возврат НаборДанных;

КонецФункции

// Добавляет набор данных - объект
//
// Параметры:
//   СКД              - СхемаКомпоновкиДанных - схема компоновки
//   Имя              - Строка - имя набора данных
//   ИмяОбъекта       - Строка - имя объекта данных
//   ИмяИсточника     - Строка - имя источника данных
//
// Возвращаемое значение:
//   НаборДанныхОбъектСхемыКомпоновкиДанных - созданный набор данных
//
Функция СздНаборОбъект(СКД, Имя, ИмяОбъекта, ИмяИсточника = "ИсточникДанных1") Экспорт

    НаборДанных = СКД.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
    НаборДанных.Имя = Имя;
    НаборДанных.ИмяОбъекта = ИмяОбъекта;
    НаборДанных.ИсточникДанных = ИмяИсточника;

    Возврат НаборДанных;

КонецФункции

// Добавляет набор данных - объединение
//
// Параметры:
//   СКД  - СхемаКомпоновкиДанных - схема компоновки
//   Имя  - Строка - имя набора данных
//
// Возвращаемое значение:
//   НаборДанныхОбъединениеСхемыКомпоновкиДанных - созданный набор данных
//
Функция СздНаборОбъединение(СКД, Имя) Экспорт

    НаборДанных = СКД.НаборыДанных.Добавить(Тип("НаборДанныхОбъединениеСхемыКомпоновкиДанных"));
    НаборДанных.Имя = Имя;

    Возврат НаборДанных;

КонецФункции

#КонецОбласти

#Область ПоляНабораДанных

// Добавляет поле в набор данных
//
// Параметры:
//   НаборДанных    - НаборДанныхСхемыКомпоновкиДанных - набор данных
//   ПутьКДанным    - Строка - путь к данным поля
//   Заголовок      - Строка - заголовок поля (необязательно, по умолчанию = ПутьКДанным)
//   ТипЗначения    - ОписаниеТипов, Неопределено - тип значения поля
//   Роль           - Строка - роль поля: "", "Измерение", "Реквизит", "Период" и др.
//
// Возвращаемое значение:
//   ПолеНабораДанныхСхемыКомпоновкиДанных - добавленное поле
//
Функция СздПоле(НаборДанных, ПутьКДанным, Заголовок = Неопределено, ТипЗначения = Неопределено, Роль = "") Экспорт

    Поле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
    Поле.ПутьКДанным = ПутьКДанным;
    Поле.Поле = ПутьКДанным;
    Поле.Заголовок = ?(Заголовок = Неопределено, ПутьКДанным, Заголовок);

    Если ТипЗначения <> Неопределено Тогда
        Поле.ТипЗначения = ТипЗначения;
    КонецЕсли;

    УстановитьРольПоля(Поле, Роль);

    Возврат Поле;

КонецФункции

// Добавляет папку полей в набор данных
//
// Параметры:
//   НаборДанных    - НаборДанныхСхемыКомпоновкиДанных - набор данных
//   ПутьКДанным    - Строка - путь к данным
//   Заголовок      - Строка - заголовок папки
//
// Возвращаемое значение:
//   ПапкаПолейНабораДанныхСхемыКомпоновкиДанных - добавленная папка
//
Функция СздПапкуПолей(НаборДанных, ПутьКДанным, Заголовок = Неопределено) Экспорт

    Папка = НаборДанных.Поля.Добавить(Тип("ПапкаПолейНабораДанныхСхемыКомпоновкиДанных"));
    Папка.ПутьКДанным = ПутьКДанным;
    Папка.Заголовок = ?(Заголовок = Неопределено, ПутьКДанным, Заголовок);

    Возврат Папка;

КонецФункции

// Добавляет поле в папку полей
//
// Параметры:
//   Папка          - ПапкаПолейНабораДанныхСхемыКомпоновкиДанных - папка полей
//   ПутьКДанным    - Строка - путь к данным поля
//   Заголовок      - Строка - заголовок поля
//   ТипЗначения    - ОписаниеТипов, Неопределено - тип значения
//
// Возвращаемое значение:
//   ПолеНабораДанныхСхемыКомпоновкиДанных - добавленное поле
//
Функция СздПолеВПапке(Папка, ПутьКДанным, Заголовок = Неопределено, ТипЗначения = Неопределено) Экспорт

    Поле = Папка.Элементы.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
    Поле.ПутьКДанным = ПутьКДанным;
    Поле.Поле = ПутьКДанным;
    Поле.Заголовок = ?(Заголовок = Неопределено, ПутьКДанным, Заголовок);

    Если ТипЗначения <> Неопределено Тогда
        Поле.ТипЗначения = ТипЗначения;
    КонецЕсли;

    Возврат Поле;

КонецФункции

#КонецОбласти

#Область ВычисляемыеПоля

// Добавляет вычисляемое поле в схему
//
// Параметры:
//   СКД            - СхемаКомпоновкиДанных - схема компоновки
//   ПутьКДанным    - Строка - путь к данным
//   Выражение      - Строка - выражение для вычисления
//   Заголовок      - Строка - заголовок поля
//   ТипЗначения    - ОписаниеТипов, Неопределено - тип значения
//
// Возвращаемое значение:
//   ВычисляемоеПолеСхемыКомпоновкиДанных - добавленное поле
//
Функция СздВычисляемоеПоле(СКД, ПутьКДанным, Выражение, Заголовок = Неопределено, ТипЗначения = Неопределено) Экспорт

    ВычПоле = СКД.ВычисляемыеПоля.Добавить();
    ВычПоле.ПутьКДанным = ПутьКДанным;
    ВычПоле.Выражение = Выражение;
    ВычПоле.Заголовок = ?(Заголовок = Неопределено, ПутьКДанным, Заголовок);

    Если ТипЗначения <> Неопределено Тогда
        ВычПоле.ТипЗначения = ТипЗначения;
    КонецЕсли;

    Возврат ВычПоле;

КонецФункции

#КонецОбласти

#Область Ресурсы

// Добавляет ресурс в схему
//
// Параметры:
//   СКД        - СхемаКомпоновкиДанных - схема компоновки
//   Поле       - Строка - имя поля ресурса
//   Выражение  - Строка - выражение для вычисления (например "СУММА(Количество)")
//
// Возвращаемое значение:
//   РесурсСхемыКомпоновкиДанных - добавленный ресурс
//
Функция СздРесурс(СКД, Поле, Выражение = Неопределено) Экспорт

    Ресурс = СКД.ПоляИтога.Добавить();
    Ресурс.ПутьКДанным = Поле;

    Если Выражение <> Неопределено Тогда
        Ресурс.Выражение = Выражение;
    Иначе
        Ресурс.Выражение = "СУММА(" + Поле + ")";
    КонецЕсли;

    Возврат Ресурс;

КонецФункции

// Добавляет ресурс с агрегатной функцией СУММА
//
Функция СздРесурсСумма(СКД, Поле) Экспорт
    Возврат СздРесурс(СКД, Поле, "СУММА(" + Поле + ")");
КонецФункции

// Добавляет ресурс с агрегатной функцией КОЛИЧЕСТВО
//
Функция СздРесурсКоличество(СКД, Поле) Экспорт
    Возврат СздРесурс(СКД, Поле, "КОЛИЧЕСТВО(" + Поле + ")");
КонецФункции

// Добавляет ресурс с агрегатной функцией МАКСИМУМ
//
Функция СздРесурсМаксимум(СКД, Поле) Экспорт
    Возврат СздРесурс(СКД, Поле, "МАКСИМУМ(" + Поле + ")");
КонецФункции

// Добавляет ресурс с агрегатной функцией МИНИМУМ
//
Функция СздРесурсМинимум(СКД, Поле) Экспорт
    Возврат СздРесурс(СКД, Поле, "МИНИМУМ(" + Поле + ")");
КонецФункции

// Добавляет ресурс с агрегатной функцией СРЕДНЕЕ
//
Функция СздРесурсСреднее(СКД, Поле) Экспорт
    Возврат СздРесурс(СКД, Поле, "СРЕДНЕЕ(" + Поле + ")");
КонецФункции

#КонецОбласти

#Область Параметры

// Добавляет параметр в схему
//
// Параметры:
//   СКД            - СхемаКомпоновкиДанных - схема компоновки
//   Имя            - Строка - имя параметра
//   Заголовок      - Строка - заголовок параметра
//   ТипЗначения    - ОписаниеТипов - тип значения параметра
//   Значение       - Произвольный - значение по умолчанию
//   ВключатьВДоступные - Булево - включать в доступные поля
//
// Возвращаемое значение:
//   ПараметрСхемыКомпоновкиДанных - добавленный параметр
//
Функция СздПараметр(СКД, Имя, Заголовок = Неопределено, ТипЗначения = Неопределено, Значение = Неопределено, ВключатьВДоступные = Ложь) Экспорт

    Параметр = СКД.Параметры.Добавить();
    Параметр.Имя = Имя;
    Параметр.Заголовок = ?(Заголовок = Неопределено, Имя, Заголовок);
    Параметр.ВключатьВДоступныеПоля = ВключатьВДоступные;

    Если ТипЗначения <> Неопределено Тогда
        Параметр.ТипЗначения = ТипЗначения;
    КонецЕсли;

    Если Значение <> Неопределено Тогда
        Параметр.Значение = Значение;
    КонецЕсли;

    Возврат Параметр;

КонецФункции

// Добавляет параметр типа Дата
//
Функция СздПараметрДата(СКД, Имя, Заголовок = Неопределено, Значение = Неопределено) Экспорт
    Возврат СздПараметр(СКД, Имя, Заголовок, Новый ОписаниеТипов("Дата"), Значение);
КонецФункции

// Добавляет параметр типа Булево
//
Функция СздПараметрБулево(СКД, Имя, Заголовок = Неопределено, Значение = Ложь) Экспорт
    Возврат СздПараметр(СКД, Имя, Заголовок, Новый ОписаниеТипов("Булево"), Значение);
КонецФункции

// Добавляет параметр типа Число
//
Функция СздПараметрЧисло(СКД, Имя, Заголовок = Неопределено, Значение = 0, Длина = 15, Точность = 2) Экспорт
    КвалификаторыЧисла = Новый КвалификаторыЧисла(Длина, Точность);
    Возврат СздПараметр(СКД, Имя, Заголовок, Новый ОписаниеТипов("Число", КвалификаторыЧисла), Значение);
КонецФункции

// Добавляет параметр типа Строка
//
Функция СздПараметрСтрока(СКД, Имя, Заголовок = Неопределено, Значение = "", Длина = 0) Экспорт
    КвалификаторыСтроки = Новый КвалификаторыСтроки(Длина);
    Возврат СздПараметр(СКД, Имя, Заголовок, Новый ОписаниеТипов("Строка",, КвалификаторыСтроки), Значение);
КонецФункции

// Добавляет стандартный период начала
//
Функция СздПараметрНачалоПериода(СКД, Значение = Неопределено) Экспорт
    Возврат СздПараметрДата(СКД, "НачалоПериода", "Начало периода", Значение);
КонецФункции

// Добавляет стандартный период окончания
//
Функция СздПараметрКонецПериода(СКД, Значение = Неопределено) Экспорт
    Возврат СздПараметрДата(СКД, "КонецПериода", "Конец периода", Значение);
КонецФункции

#КонецОбласти

#Область НастройкиСхемы

// Получает или создает настройки по умолчанию для схемы
//
// Параметры:
//   СКД - СхемаКомпоновкиДанных - схема компоновки
//
// Возвращаемое значение:
//   НастройкиКомпоновкиДанных - настройки по умолчанию
//
Функция ПолучитьНастройкиПоУмолчанию(СКД) Экспорт

    Если СКД.НастройкиПоУмолчанию = Неопределено Тогда
        СКД.НастройкиПоУмолчанию = Новый НастройкиКомпоновкиДанных;
    КонецЕсли;

    Возврат СКД.НастройкиПоУмолчанию;

КонецФункции

// Получает или создает вариант настроек
//
// Параметры:
//   СКД      - СхемаКомпоновкиДанных - схема компоновки
//   Имя      - Строка - имя варианта
//   Описание - Строка - описание варианта
//
// Возвращаемое значение:
//   ВариантНастроекКомпоновкиДанных - вариант настроек
//
Функция СздВариантНастроек(СКД, Имя, Описание = "") Экспорт

    Вариант = СКД.ВариантыНастроек.Добавить();
    Вариант.Имя = Имя;
    Вариант.Описание = Описание;
    Вариант.Настройки = Новый НастройкиКомпоновкиДанных;

    Возврат Вариант;

КонецФункции

#КонецОбласти

#Область СтруктураНастроек

// Добавляет группировку в настройки
//
// Параметры:
//   Настройки  - НастройкиКомпоновкиДанных, ГруппировкаКомпоновкиДанных - настройки или родительская группировка
//   ИмяПоля    - Строка - имя поля группировки ("" для детальных записей)
//   Заголовок  - Строка - заголовок группировки
//
// Возвращаемое значение:
//   ГруппировкаКомпоновкиДанных - добавленная группировка
//
Функция СздГруппировку(Настройки, ИмяПоля = "", Заголовок = "") Экспорт

    // Определяем куда добавлять
    Если ТипЗнч(Настройки) = Тип("НастройкиКомпоновкиДанных") Тогда
        Структура = Настройки.Структура;
    Иначе
        Структура = Настройки.Структура;
    КонецЕсли;

    Группировка = Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));

    Если ЗначениеЗаполнено(ИмяПоля) Тогда
        ПолеГруппировки = Группировка.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
        ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
        ПолеГруппировки.Использование = Истина;
    КонецЕсли;

    Возврат Группировка;

КонецФункции

// Добавляет таблицу в настройки
//
// Параметры:
//   Настройки - НастройкиКомпоновкиДанных - настройки
//
// Возвращаемое значение:
