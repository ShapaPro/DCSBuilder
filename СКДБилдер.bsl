// Устанавливает значение параметра в настройках
//
// Параметры:
//   Настройки      - НастройкиКомпоновкиДанных - настройки компоновки
//   ИмяПараметра   - Строка - имя параметра
//   Значение       - Произвольный - значение параметра
//   Использование  - Булево - использовать параметр
//
Процедура УстановитьПараметр(Настройки, ИмяПараметра, Значение, Использование = Истина) Экспорт

    Параметр = Настройки.ПараметрыДанных.Элементы.Найти(ИмяПараметра);

    Если Параметр <> Неопределено Тогда
        Параметр.Значение = Значение;
        Параметр.Использование = Использование;
    КонецЕсли;

КонецПроцедуры

// Устанавливает период в настройках
//
// Параметры:
//   Настройки      - НастройкиКомпоновкиДанных - настройки компоновки
//   НачалоПериода  - Дата - начало периода
//   КонецПериода   - Дата - конец периода
//
Процедура УстановитьПериод(Настройки, НачалоПериода, КонецПериода) Экспорт

    УстановитьПараметр(Настройки, "НачалоПериода", НачалоПериода);
    УстановитьПараметр(Настройки, "КонецПериода", КонецПериода);

КонецПроцедуры

#КонецОбласти

#Область Вывод

// Выводит СКД в табличный документ
//
// Параметры:
//   СКД                - СхемаКомпоновкиДанных - схема компоновки
//   Настройки          - НастройкиКомпоновкиДанных - настройки (если Неопределено, используются настройки по умолчанию)
//   ВнешниеНаборы      - Структура - внешние наборы данных
//   ДанныеРасшифровки  - ДанныеРасшифровкиКомпоновкиДанных - данные расшифровки
//
// Возвращаемое значение:
//   ТабличныйДокумент - результат вывода
//
Функция ВывестиВТабличныйДокумент(СКД, Настройки = Неопределено, ВнешниеНаборы = Неопределено, ДанныеРасшифровки = Неопределено) Экспорт

    Если Настройки = Неопределено Тогда
        Настройки = СКД.НастройкиПоУмолчанию;
    КонецЕсли;

    КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
    МакетКомпоновки = КомпоновщикМакета.Выполнить(СКД, Настройки, ДанныеРасшифровки);

    ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
    ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборы, ДанныеРасшифровки);

    ТабДок = Новый ТабличныйДокумент;
    ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
    ПроцессорВывода.УстановитьДокумент(ТабДок);
    ПроцессорВывода.Вывести(ПроцессорКомпоновки);

    Возврат ТабДок;

КонецФункции

