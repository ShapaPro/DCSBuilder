
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)

    СтандартнаяОбработка = Ложь;

    СКД = ПолучитьСхемуОСВ();

    КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СКД));
    КомпоновщикНастроек.ЗагрузитьНастройки(КомпоновщикНастроек.Настройки);

    КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
    МакетКомпоновки = КомпоновщикМакета.Выполнить(СКД, КомпоновщикНастроек.Настройки, ДанныеРасшифровки);

    ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
    ПроцессорКомпоновки.Инициализировать(МакетКомпоновки,, ДанныеРасшифровки);

    ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
    ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
    ПроцессорВывода.Вывести(ПроцессорКомпоновки);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.ВариантыОтчетов

Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт

    Настройки.ВариантПредставленияПериода = Перечисления.ВариантыПредставленияПериода.Гиперссылка;
    Настройки.ВариантПериода = Перечисления.ВариантыПериода.Финансовый;

КонецПроцедуры

// Конец СтандартныеПодсистемы.ВариантыОтчетов

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьСхемуОСВ()

    ТекстЗапроса = 
    "ВЫБРАТЬ
    |   ОстаткиИОбороты.Счет КАК Счет,
    |   ОстаткиИОбороты.Организация КАК Организация,
    |   ОстаткиИОбороты.Валюта КАК Валюта,
    |   ОстаткиИОбороты.Регистратор КАК Документ,
    |   ОстаткиИОбороты.СуммаНачальныйОстатокДт КАК СуммаНачОстДт,
    |   ОстаткиИОбороты.СуммаНачальныйОстатокКт КАК СуммаНачОстКт,
    |   ОстаткиИОбороты.СуммаОборотДт КАК СуммаОборотДт,
    |   ОстаткиИОбороты.СуммаОборотКт КАК СуммаОборотКт,
    |   ОстаткиИОбороты.СуммаКонечныйОстатокДт КАК СуммаКонОстДт,
    |   ОстаткиИОбороты.СуммаКонечныйОстатокКт КАК СуммаКонОстКт,
    |   ОстаткиИОбороты.КоличествоНачальныйОстатокДт КАК КоличествоНачОстДт,
    |   ОстаткиИОбороты.КоличествоНачальныйОстатокКт КАК КоличествоНачОстКт,
    |   ОстаткиИОбороты.КоличествоОборотДт КАК КоличествоОборотДт,
    |   ОстаткиИОбороты.КоличествоОборотКт КАК КоличествоОборотКт,
    |   ОстаткиИОбороты.КоличествоКонечныйОстатокДт КАК КоличествоКонОстДт,
    |   ОстаткиИОбороты.КоличествоКонечныйОстатокКт КАК КоличествоКонОстКт,
    |   ОстаткиИОбороты.ВалютнаяСуммаНачальныйОстатокДт КАК ВалютнаяСуммаНачОстДт,
    |   ОстаткиИОбороты.ВалютнаяСуммаНачальныйОстатокКт КАК ВалютнаяСуммаНачОстКт,
    |   ОстаткиИОбороты.ВалютнаяСуммаОборотДт КАК ВалютнаяСуммаОборотДт,
    |   ОстаткиИОбороты.ВалютнаяСуммаОборотКт КАК ВалютнаяСуммаОборотКт,
    |   ОстаткиИОбороты.ВалютнаяСуммаКонечныйОстатокДт КАК ВалютнаяСуммаКонОстДт,
    |   ОстаткиИОбороты.ВалютнаяСуммаКонечныйОстатокКт КАК ВалютнаяСуммаКонОстКт
    |ИЗ
    |   РегистрБухгалтерии._ДемоЖурналПроводокБухгалтерскогоУчета.ОстаткиИОбороты(
    |       {&НачалоПериода}, {&КонецПериода}, АВТО, ,
    |       {Счет В ИЕРАРХИИ(&Счет)},
    |       ,
    |       {Организация = &Организация} {Валюта = &Валюта}
    |   ) КАК ОстаткиИОбороты";

    // Создаём схему с источником данных
    СКД = СКДБилдер.СоздатьСхемуСИсточником();

    // Набор данных - запрос
    СКДБилдер.СздНаборЗапрос(СКД, "НаборДанных1", ТекстЗапроса);

    // Ресурсы - Суммы
    СКДБилдер.СздРесурс(СКД, "СуммаНачОстДт");
    СКДБилдер.СздРесурс(СКД, "СуммаНачОстКт");
    СКДБилдер.СздРесурс(СКД, "СуммаОборотДт");
    СКДБилдер.СздРесурс(СКД, "СуммаОборотКт");
    СКДБилдер.СздРесурс(СКД, "СуммаКонОстДт");
    СКДБилдер.СздРесурс(СКД, "СуммаКонОстКт");

    // Ресурсы - Количество
    СКДБилдер.СздРесурс(СКД, "КоличествоНачОстДт");
    СКДБилдер.СздРесурс(СКД, "КоличествоНачОстКт");
    СКДБилдер.СздРесурс(СКД, "КоличествоОборотДт");
    СКДБилдер.СздРесурс(СКД, "КоличествоОборотКт");
    СКДБилдер.СздРесурс(СКД, "КоличествоКонОстДт");
    СКДБилдер.СздРесурс(СКД, "КоличествоКонОстКт");

    // Ресурсы - Валютная сумма
    СКДБилдер.СздРесурс(СКД, "ВалютнаяСуммаНачОстДт");
    СКДБилдер.СздРесурс(СКД, "ВалютнаяСуммаНачОстКт");
    СКДБилдер.СздРесурс(СКД, "ВалютнаяСуммаОборотДт");
    СКДБилдер.СздРесурс(СКД, "ВалютнаяСуммаОборотКт");
    СКДБилдер.СздРесурс(СКД, "ВалютнаяСуммаКонОстДт");
    СКДБилдер.СздРесурс(СКД, "ВалютнаяСуммаКонОстКт");

    // Параметры
    СКДБилдер.СздПараметрНачалоПериода(СКД);
    СКДБилдер.СздПараметрКонецПериода(СКД);
    СКДБилдер.СздПараметр(СКД, "Период", "Период");
    СКДБилдер.СздПараметр(СКД, "Валюта", "Валюта");
    СКДБилдер.СздПараметр(СКД, "Счет", "Счет");
    СКДБилдер.СздПараметр(СКД, "Организация", "Организация");

    // Настройки
    Настройки = СКДБилдер.ПолучитьНастройкиПоУмолчанию(СКД);

    // Группировки
    СКДБилдер.СздГруппировку(Настройки, "Организация");
    СКДБилдер.СздГруппировку(Настройки, "Счет");
    СКДБилдер.СздГруппировку(Настройки, "Валюта");

    // Выбранные поля
    НастроитьВыбранныеПоляОСВ(Настройки);

    // Сортировка
    СКДБилдер.СздСортировкуВозр(Настройки, "Счет");

    Возврат СКД;

КонецФункции

Процедура НастроитьВыбранныеПоляОСВ(Настройки)

    // Группа "Начальный остаток"
    ГруппаНачОст = Настройки.Выбор.Элементы.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
    ГруппаНачОст.Заголовок = "Начальный остаток";

    ДобавитьГруппуПолейДтКт(ГруппаНачОст, "Сумма", "СуммаНачОстДт", "СуммаНачОстКт");
    ДобавитьГруппуПолейДтКт(ГруппаНачОст, "Количество", "КоличествоНачОстДт", "КоличествоНачОстКт");
    ДобавитьГруппуПолейДтКт(ГруппаНачОст, "Валютная сумма", "ВалютнаяСуммаНачОстДт", "ВалютнаяСуммаНачОстКт");

    // Группа "Оборот"
    ГруппаОборот = Настройки.Выбор.Элементы.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
    ГруппаОборот.Заголовок = "Оборот";

    ДобавитьГруппуПолейДтКт(ГруппаОборот, "Сумма", "СуммаОборотДт", "СуммаОборотКт");
    ДобавитьГруппуПолейДтКт(ГруппаОборот, "Количество", "КоличествоОборотДт", "КоличествоОборотКт");
    ДобавитьГруппуПолейДтКт(ГруппаОборот, "Валютная сумма", "ВалютнаяСуммаОборотДт", "ВалютнаяСуммаОборотКт");

    // Группа "Конечный остаток"
    ГруппаКонОст = Настройки.Выбор.Элементы.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
    ГруппаКонОст.Заголовок = "Конечный остаток";

    ДобавитьГруппуПолейДтКт(ГруппаКонОст, "Сумма", "СуммаКонОстДт", "СуммаКонОстКт");
    ДобавитьГруппуПолейДтКт(ГруппаКонОст, "Количество", "КоличествоКонОстДт", "КоличествоКонОстКт");
    ДобавитьГруппуПолейДтКт(ГруппаКонОст, "Валютная сумма", "ВалютнаяСуммаКонОстДт", "ВалютнаяСуммаКонОстКт");

КонецПроцедуры

Процедура ДобавитьГруппуПолейДтКт(РодительскаяГруппа, Заголовок, ПолеДт, ПолеКт)

    Группа = РодительскаяГруппа.Элементы.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
    Группа.Заголовок = Заголовок;

    ПолеВыбораДт = Группа.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
    ПолеВыбораДт.Поле = Новый ПолеКомпоновкиДанных(ПолеДт);
    ПолеВыбораДт.Заголовок = "Дт";

    ПолеВыбораКт = Группа.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
    ПолеВыбораКт.Поле = Новый ПолеКомпоновкиДанных(ПолеКт);
    ПолеВыбораКт.Заголовок = "Кт";

КонецПроцедуры

#КонецОбласти

